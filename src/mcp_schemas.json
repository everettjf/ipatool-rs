{
  "download_app": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "description": "Numeric app ID; required unless bundle_identifier is provided",
          "type": "integer"
        },
        "bundle_identifier": {
          "description": "Bundle identifier; overrides app_id when found",
          "type": "string"
        },
        "external_version_id": {
          "description": "External version identifier; defaults to the latest version",
          "type": "string"
        },
        "output": {
          "description": "Destination file or directory; defaults to the server's working directory",
          "type": "string"
        },
        "platform": {
          "description": "iphone (ios), ipad (ipados), appletv (tvos), watchos, visionos, or macos; uses the CLI default when omitted",
          "type": "string"
        },
        "purchase": {
          "description": "Acquire a free license if needed; defaults to false",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "additionalProperties": false,
          "properties": {
            "bundleId": {
              "type": "string"
            },
            "platforms": {
              "items": {
                "type": "string"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "price": {
              "type": "number"
            },
            "purchaseDate": {
              "type": [
                "null",
                "string"
              ]
            },
            "trackId": {
              "type": "integer"
            },
            "trackName": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "trackId",
            "bundleId",
            "trackName",
            "version",
            "price",
            "purchaseDate",
            "platforms"
          ],
          "type": "object"
        },
        "app_id": {
          "type": "integer"
        },
        "bundle_identifier": {
          "type": "string"
        },
        "external_version_id": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "purchase": {
          "type": "boolean"
        },
        "purchased": {
          "type": "boolean"
        },
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "app_id",
        "bundle_identifier",
        "platform",
        "app",
        "output",
        "external_version_id",
        "purchase",
        "purchased",
        "success"
      ],
      "type": "object"
    }
  },
